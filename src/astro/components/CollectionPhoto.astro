---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
interface Props { image: ImageMetadata; alt: string; eager?: boolean; position?: string; sizes?: string }
const { image, alt, eager = false, position = 'center', sizes = '(min-width: 1024px) 30vw, (min-width: 768px) 60vw, 95vw' } = Astro.props
---
<div class="media-frame">
  <Image src={image} alt={alt} widths={[360, 640, 768, 960]} sizes={sizes} format="webp" quality={82} loading={eager ? 'eager' : 'lazy'} decoding="async" style={{ objectPosition: position }} />
  <span class="media-unavailable" hidden>Image unavailable</span>
</div>
