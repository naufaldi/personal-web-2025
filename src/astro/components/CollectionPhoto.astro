---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
interface Props { image: ImageMetadata; alt: string; eager?: boolean; position?: string }
const { image, alt, eager = false, position = 'center' } = Astro.props
---
<div class="media-frame">
  <Image src={image} alt={alt} widths={[360, 640, 960]} sizes="(min-width: 1280px) 35vw, (min-width: 768px) 55vw, 95vw" format="webp" quality={82} loading={eager ? 'eager' : 'lazy'} decoding="async" style={{ objectPosition: position }} />
  <span class="media-unavailable" hidden>Image unavailable</span>
</div>
