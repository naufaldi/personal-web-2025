---
import type { SeoRoute } from '@/lib/seo'
import { renderSeoBlock } from '../../../scripts/seo-render'
interface Props { route: SeoRoute; collection?: boolean }
const { route, collection = false } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Fragment set:html={renderSeoBlock(route)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="Faldi LLM context" />
    <meta name="theme-color" content={collection ? '#F5F3ED' : '#020817'} />
    {collection && <link rel="preload" href="/fonts/archivo-black-latin-400.woff2" as="font" type="font/woff2" crossorigin />}
    {!collection && <link href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;600;700&family=Manrope:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />}
    <slot name="head" />
  </head>
  <body><slot /></body>
</html>
