---
import CollectionHeader from '../components/CollectionHeader.astro'
import Document from '../layouts/Document.astro'
import '../styles/collected.css'
import { siteMetadata } from '../../../scripts/seo-data'
const route = { path: '/404', title: 'Page not found | Faldi', description: 'This page is not in the collection.', canonicalUrl: `${siteMetadata.siteUrl}/404`, lastmod: '', priority: 0, changefreq: 'never' as const, kind: 'page' as const, noindex: true }
---
<Document route={route} collection>
  <div class="collection-layout">
    <CollectionHeader />
    <main class="state-page">
      <img src="/images/states/not-found.webp" width="720" height="720" alt="" />
      <div>
        <p class="font-mono text-caption text-vermilion">NOT IN THE COLLECTION / 404</p>
        <h1 class="font-display">Lost page.</h1>
        <p class="text-body">This page may have moved, or the address may be incomplete.</p>
        <nav class="state-actions font-mono text-nav" aria-label="Find your way"><a href="/">Home</a><a href="/projects">Projects</a></nav>
      </div>
    </main>
  </div>
</Document>
