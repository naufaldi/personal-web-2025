---
import Document from '../layouts/Document.astro'
import Artifact from '../components/Artifact.astro'
import CollectionHeader from '@/astro/components/CollectionHeader.astro'
import { artifacts } from '@/data/collected'
import { buildSeoRoutes } from '../../../scripts/seo-data'
import '../styles/collected.css'
const { routes } = await buildSeoRoutes()
const route = routes.find(route => route.path === '/')!
---
<Document route={route} collection>
  <a class="skip-link font-mono text-nav" href="#collection">Skip to collection</a>
  <div class="collection-layout" data-collection>
    <CollectionHeader />
    <main id="collection" tabindex="-1">
      <div id="index" class="collection-canvas" data-canvas>
        <div class="collection-title"><p class="font-mono">COLLECTED<br />BY</p><h1 class="font-display text-display">FALDI<span class="sr-only">: work, people, and everyday moments</span></h1></div>
        <p class="margin-note font-mono text-caption"><span class="text-vermilion">01</span><br />People<br />Places<br />Ideas<br />In progress</p>
        {artifacts.map((artifact, i) => <Artifact artifact={artifact} number={i + 1} />)}
      </div>
    </main>
  </div>
  <script>import '../scripts/collection'</script>
</Document>
