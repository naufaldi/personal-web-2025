---
import Document from '../layouts/Document.astro'
import CollectionHeader from '../components/CollectionHeader.astro'
import Photo from '../components/CollectionPhoto.astro'
import { aboutBio, techStack } from '@/data/about'
import portrait from '@/assets/collected/portrait.jpg'
import workspace from '@/assets/collected/workspace.jpg'
import community from '@/assets/collected/community.jpg'
import personal from '@/assets/collected/personal.jpg'
import friends from '@/assets/collected/friends.jpg'
import { buildSeoRoutes } from '../../../scripts/seo-data'
import '../styles/collected.css'
import '../styles/inner-collections.css'
const { routes } = await buildSeoRoutes()
const route = routes.find(route => route.path === '/about')!
---
<Document route={route} collection>
  <a class="skip-link font-mono text-nav" href="#profile">Skip to profile</a>
  <div class="collection-layout inner-collection" data-editorial>
    <CollectionHeader />
    <main id="profile" tabindex="-1">
      <div class="editorial-board about-board" data-board>
        <h1 class="editorial-title font-display">ABOUT</h1>
        <p class="editorial-margin font-mono text-caption">People<br />Technology<br />Community<br />A more open web</p>
        <figure class="about-portrait"><Photo image={portrait} alt="Faldi outdoors in a blue shirt" eager /><figcaption>Profile /<br />Naufaldi Rafif Satriya</figcaption></figure>
        <div class="about-intro">
          <h2 class="text-heading">{aboutBio.name}</h2>
          <p class="text-body">{aboutBio.bioParagraphs[0]}</p>
          <a class="editorial-link font-mono text-nav" href="/experience">Read experience <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="about-workspace"><Photo image={workspace} alt="Faldi’s desk with two monitors" eager /><figcaption>Software /<br />Ideas into tools <span class="text-vermilion">01</span></figcaption></figure>
        <figure class="about-community"><a href="/speaker"><Photo image={community} alt="Friends gathered around a cafe table" /></a><figcaption>Community /<br /><a href="/speaker">Learning together ↗</a> <span class="text-vermilion">02</span></figcaption></figure>
        <figure class="about-tools"><Photo image={personal} alt="Two game controllers in front of a screen" /><figcaption>Off screen /<br />Making room for life</figcaption></figure>
        <figure class="about-quiet"><Photo image={friends} alt="A gathering with friends at a cafe" /><figcaption>People /<br />Conversations beyond code</figcaption></figure>
      </div>
      <div class="editorial-controls font-mono text-nav"><nav aria-label="Profile views"><a href="#profile" data-profile>Profile</a><a id="experiences-heading" href="/experience">Experience</a><a href="/speaker">Mentoring ↗</a></nav><a href="#index" data-view-toggle>Open index ↗</a></div>
      <section class="editorial-index" id="index" aria-labelledby="about-index-heading" data-directory>
        <h2 id="about-index-heading" class="font-display text-reading-title" tabindex="-1">A little more about me.</h2>
        <p class="text-body reading-copy">{aboutBio.bioParagraphs[2]}</p>
        <p class="font-mono text-caption">Working with / {techStack.map(item => item.name).join(' · ')}</p>
      </section>
      <p class="sr-only" role="status" data-editorial-status></p>
    </main>
  </div>
  <script>
    import '@/astro/scripts/editorial'
    const openExperience = () => { if (location.hash === '#experiences-heading') location.replace('/experience') }
    addEventListener('hashchange', openExperience)
    openExperience()
  </script>
</Document>
