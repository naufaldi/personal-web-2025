---
import Reading from '../layouts/Reading.astro'
import { buildSeoRoutes } from '../../../scripts/seo-data'
import { projectCover } from '@/data/projectCollection'
import { portfolioItems } from '@/data/portfolio'
import { writingEntries } from '@/data/writingCollection'
export async function getStaticPaths() {
  const { routes } = await buildSeoRoutes()
  return routes.filter(route => route.kind === 'project' || route.kind === 'blog').map(route => ({ params: { path: route.path.slice(1) }, props: { route } }))
}
const { route } = Astro.props
const slug = route.path.split('/').slice(-1)[0]!
const project = route.kind === 'project' ? portfolioItems.find(item => item.slug === slug) : undefined
const cover = project ? projectCover(slug) : undefined
const writing = writingEntries.find(item => item.id === slug)
const title = project?.title ?? writing?.title ?? route.title.replace(/ - Blog - Naufaldi Rafif Satriya$/, '')
const meta = project ? project.techStack.join(' / ') : `${writing?.categories.join(' / ') ?? 'Writing'} / ${writing?.meta ?? route.date}`
const links = project ? [{ title: 'View project', href: project.liveUrl }, { title: 'Source code', href: project.githubUrl }].filter((link): link is {title: string; href: string} => Boolean(link.href && /^https?:\/\//.test(link.href))) : []
---
<Reading route={route} title={title} meta={meta} summary={project?.description} cover={cover?.image} coverKind={cover?.kind} links={links} />
